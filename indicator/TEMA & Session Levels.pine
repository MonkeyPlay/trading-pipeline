//@version=6
indicator("TEMA & Session Levels", overlay = true, max_lines_count = 20, max_labels_count = 20)

// ==========================================
// 1. TEMA & EMA INPUTS
// ==========================================
grpTema       = "TEMA & EMA 9 Settings"
temaLen       = input.int(14, title="TEMA Length", group=grpTema)
smoothLen     = input.int(3,  title="TEMA Smoothing Length", group=grpTema) 
emaTrigLen    = input.int(14, title="Trigger EMA Length", group=grpTema) 
smoothEma9Len = input.int(3,  title="EMA9 Smoothing Length", group=grpTema) 

grpTrendBands = "Trend Bands"
emaTrendLen   = input.int(100, title="Trend EMA Length", group=grpTrendBands) 

// ==========================================
// 2. SESSION LEVELS INPUTS
// ==========================================
grpSess = "Session Times (defaults tuned for US index futures, e.g. ES/NQ)"
sessTZ  = input.string("America/New_York", "Timezone", group = grpSess,
     tooltip = "IANA timezone used to evaluate all sessions below, e.g. America/New_York, America/Chicago, Europe/London")
rthSess = input.session("0930-1615", "RTH Session", group = grpSess,
     tooltip = "Regular Trading Hours, e.g. cash session for the underlying index")
onSess  = input.session("1800-0930", "Overnight (ON) Session", group = grpSess,
     tooltip = "Session that wraps midnight: prior day open time to next day RTH open, e.g. Globex open to cash open")
pmSess  = input.session("0800-0930", "Premarket Session", group = grpSess,
     tooltip = "Pre-open ramp-up window immediately before RTH open")

grpRTH      = "Previous RTH"
showPrevRTH = input.bool(true, "Show Previous RTH High/Low/Open", group = grpRTH)
colPrevHigh = input.color(color.new(color.lime, 0),  "High", group = grpRTH, inline = "rth")
colPrevLow  = input.color(color.new(color.red, 0),   "Low",  group = grpRTH, inline = "rth")
colPrevOpen = input.color(color.new(color.gray, 0),  "Open", group = grpRTH, inline = "rth")

grpON     = "Overnight (ON)"
showON    = input.bool(true, "Show ON High/Low/Open", group = grpON)
colONHigh = input.color(color.new(color.aqua, 0),    "High", group = grpON, inline = "on")
colONLow  = input.color(color.new(color.orange, 0),  "Low",  group = grpON, inline = "on")
colONOpen = input.color(color.new(color.blue, 0),    "Open", group = grpON, inline = "on")

grpPM     = "Premarket"
showPM    = input.bool(true, "Show Premarket High/Low", group = grpPM)
colPMHigh = input.color(color.new(color.fuchsia, 0), "High", group = grpPM, inline = "pm")
colPMLow  = input.color(color.new(color.yellow, 0),  "Low",  group = grpPM, inline = "pm")

grpStyle    = "Style"
lineWidth   = input.int(1, "Line Width", minval = 1, maxval = 4, group = grpStyle)
lineStyleIn = input.string("Solid", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = grpStyle)
showLabels  = input.bool(true, "Show Price Labels", group = grpStyle)
labelOffset = input.int(5, "Label Offset (bars)", minval = 0, maxval = 50, group = grpStyle)

lineStyle = lineStyleIn == "Dashed" ? line.style_dashed : lineStyleIn == "Dotted" ? line.style_dotted : line.style_solid

if not timeframe.isintraday
    runtime.error("This indicator requires an intraday chart (e.g. 1, 5, 15 minute).")

// ==========================================
// 3. TEMA & EMA CALCULATIONS & PLOTS
// ==========================================
ema1         = ta.ema(close, temaLen)
ema2         = ta.ema(ema1, temaLen)
ema3         = ta.ema(ema2, temaLen)
temaRaw      = 3 * (ema1 - ema2) + ema3
temaSmoothed = ta.sma(temaRaw, smoothLen)
ema50        = ta.ema(close, emaTrendLen)          
ema9         = ta.ema(close, emaTrigLen)
ema9Smoothed = ta.sma(ema9, smoothEma9Len)

plot(temaSmoothed, "TEMA Smoothed", color=color.purple, linewidth=2)
plot(ema50, "EMA 50", color=color.blue, linewidth=2)
plot(ema9Smoothed, "EMA 9 Smoothed", color=color.orange)

// ==========================================
// 4. SESSION DETECTION & ACCUMULATORS
// ==========================================
inRTH = not na(time(timeframe.period, rthSess, sessTZ))
inON  = not na(time(timeframe.period, onSess,  sessTZ))
inPM  = not na(time(timeframe.period, pmSess,  sessTZ))

newRTH = inRTH and not inRTH[1]
newON  = inON  and not inON[1]
newPM  = inPM  and not inPM[1]

var float rthHigh = na
var float rthLow  = na
var float rthOpen = na
var float prevRthHigh = na
var float prevRthLow  = na
var float prevRthOpen = na

if newRTH
    prevRthHigh := rthHigh
    prevRthLow  := rthLow
    prevRthOpen := rthOpen
    rthHigh := high
    rthLow  := low
    rthOpen := open
else if inRTH
    rthHigh := math.max(nz(rthHigh, high), high)
    rthLow  := math.min(nz(rthLow, low), low)

var float onHigh   = na
var float onLow    = na
var float onOpen   = na
var int   onStartBar = na

if newON
    onHigh := high
    onLow  := low
    onOpen := open
    onStartBar := bar_index
else if inON
    onHigh := math.max(nz(onHigh, high), high)
    onLow  := math.min(nz(onLow, low), low)

var float pmHigh   = na
var float pmLow    = na
var int   pmStartBar = na

if newPM
    pmHigh := high
    pmLow  := low
    pmStartBar := bar_index
else if inPM
    pmHigh := math.max(nz(pmHigh, high), high)
    pmLow  := math.min(nz(pmLow, low), low)

// ==========================================
// 5. SESSION DRAWING HELPERS
// ==========================================
f_drawLine(_lineId, _x, _y, _col) =>
    line.delete(_lineId)
    line.new(_x, _y, _x, _y, xloc = xloc.bar_index, extend = extend.right, color = _col, style = lineStyle, width = lineWidth)

f_drawLabel(_lblId, _y, _txt, _col) =>
    label.delete(_lblId)
    label.new(bar_index + labelOffset, _y, _txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(_col, 85), textcolor = _col, size = size.small)

// ==========================================
// 6. DRAWING SESSION LINES & LABELS
// ==========================================
var line lnPrevRthHigh = na
var line lnPrevRthLow  = na
var line lnPrevRthOpen = na
var label lbPrevRthHigh = na
var label lbPrevRthLow  = na
var label lbPrevRthOpen = na

if showPrevRTH and newRTH
    lnPrevRthHigh := f_drawLine(lnPrevRthHigh, bar_index, prevRthHigh, colPrevHigh)
    lnPrevRthLow  := f_drawLine(lnPrevRthLow,  bar_index, prevRthLow,  colPrevLow)
    lnPrevRthOpen := f_drawLine(lnPrevRthOpen, bar_index, prevRthOpen, colPrevOpen)

if showPrevRTH and showLabels and barstate.islast and not na(prevRthHigh)
    lbPrevRthHigh := f_drawLabel(lbPrevRthHigh, prevRthHigh, "Prev RTH High " + str.tostring(prevRthHigh), colPrevHigh)
    lbPrevRthLow  := f_drawLabel(lbPrevRthLow,  prevRthLow,  "Prev RTH Low "  + str.tostring(prevRthLow),  colPrevLow)
    lbPrevRthOpen := f_drawLabel(lbPrevRthOpen, prevRthOpen, "Prev RTH Open " + str.tostring(prevRthOpen), colPrevOpen)

var line lnOnHigh = na
var line lnOnLow  = na
var line lnOnOpen = na
var label lbOnHigh = na
var label lbOnLow  = na
var label lbOnOpen = na

if showON and (newON or (inON and barstate.isconfirmed))
    lnOnHigh := f_drawLine(lnOnHigh, onStartBar, onHigh, colONHigh)
    lnOnLow  := f_drawLine(lnOnLow,  onStartBar, onLow,  colONLow)
    lnOnOpen := f_drawLine(lnOnOpen, onStartBar, onOpen, colONOpen)

if showON and showLabels and barstate.islast and not na(onHigh)
    lbOnHigh := f_drawLabel(lbOnHigh, onHigh, "ON High "     + str.tostring(onHigh), colONHigh)
    lbOnLow  := f_drawLabel(lbOnLow,  onLow,  "ON Low "      + str.tostring(onLow),  colONLow)
    lbOnOpen := f_drawLabel(lbOnOpen, onOpen, "Overnight Open " + str.tostring(onOpen), colONOpen)

var line lnPmHigh = na
var line lnPmLow  = na
var label lbPmHigh = na
var label lbPmLow  = na

if showPM and (newPM or (inPM and barstate.isconfirmed))
    lnPmHigh := f_drawLine(lnPmHigh, pmStartBar, pmHigh, colPMHigh)
    lnPmLow  := f_drawLine(lnPmLow,  pmStartBar, pmLow,  colPMLow)

if showPM and showLabels and barstate.islast and not na(pmHigh)
    lbPmHigh := f_drawLabel(lbPmHigh, pmHigh, "Premarket High " + str.tostring(pmHigh), colPMHigh)
    lbPmLow  := f_drawLabel(lbPmLow,  pmLow,  "Premarket Low "  + str.tostring(pmLow),  colPMLow)