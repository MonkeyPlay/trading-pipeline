//@version=6
indicator("Auto Anchored VWAP [v6]", shorttitle="AAVWAP", overlay=true, max_polylines_count=100)

// —————————————————————————————————————————————————————————————————————————————
// INPUTS & CONFIGURATION
// —————————————————————————————————————————————————————————————————————————————
string G_ANCHOR = "Anchor Settings"
string anchorPeriod = input.string("Auto", "Anchor Period", 
     options=["Auto", "Highest High", "Lowest Low", "Highest Volume", "Session", "Week", "Month", "Quarter", "Year"], 
     group=G_ANCHOR, tooltip="Auto dynamically adapts: Session on intraday, Month on Daily, Quarter on Multi-Day, Year on Multi-Month.")
int lookbackLength  = input.int(100, "Lookback Length (for HH / LL / HV)", minval=2, group=G_ANCHOR)
series float src    = input.source(hlc3, "Source", group=G_ANCHOR)

string G_BANDS = "Bands Configuration"
string calcMode = input.string("Standard Deviation", "Bands Calculation Mode", options=["Standard Deviation", "Percentage"], group=G_BANDS)

bool showBand1   = input.bool(true, "Band 1", inline="B1", group=G_BANDS)
float mult1      = input.float(1.0, "Multiplier 1", inline="B1", minval=0.0, step=0.5, group=G_BANDS)
color colorBand1 = input.color(color.new(#2962ff, 40), "", inline="B1", group=G_BANDS)

bool showBand2   = input.bool(false, "Band 2", inline="B2", group=G_BANDS)
float mult2      = input.float(2.0, "Multiplier 2", inline="B2", minval=0.0, step=0.5, group=G_BANDS)
color colorBand2 = input.color(color.new(#e91e63, 50), "", inline="B2", group=G_BANDS)

bool showBand3   = input.bool(false, "Band 3", inline="B3", group=G_BANDS)
float mult3      = input.float(3.0, "Multiplier 3", inline="B3", minval=0.0, step=0.5, group=G_BANDS)
color colorBand3 = input.color(color.new(#ff9800, 60), "", inline="B3", group=G_BANDS)

bool fillBands   = input.bool(true, "Fill Inner Band Background", group=G_BANDS)
color fillColor  = input.color(color.new(#2962ff, 90), "Fill Color", group=G_BANDS)
color vwapColor  = input.color(color.new(#ff9800, 0), "VWAP Line Color", group=G_ANCHOR)
int vwapWidth    = input.int(2, "VWAP Line Width", minval=1, maxval=4, group=G_ANCHOR)

// Ensure sufficient historical buffer for dynamic loops
max_bars_back(src, 5000)
max_bars_back(volume, 5000)
max_bars_back(high, 5000)
max_bars_back(low, 5000)

// —————————————————————————————————————————————————————————————————————————————
// ANCHOR DETECTION LOGIC
// —————————————————————————————————————————————————————————————————————————————
bool isNewSession = timeframe.change("D")
bool isNewWeek    = timeframe.change("W")
bool isNewMonth   = timeframe.change("M")
bool isNewQuarter = timeframe.change("3M")
bool isNewYear    = timeframe.change("12M")

// Auto Anchor timeframe resolution logic
bool isAutoAnchor = switch
    timeframe.isintraday => isNewSession
    timeframe.isdaily    => isNewMonth
    timeframe.isweekly   => isNewQuarter
    => isNewYear

bool isPeriodAnchor = switch anchorPeriod
    "Auto"           => isAutoAnchor
    "Session"        => isNewSession
    "Week"           => isNewWeek
    "Month"          => isNewMonth
    "Quarter"        => isNewQuarter
    "Year"           => isNewYear
    => false

// Track historical bar indices of period boundaries
var int lastPeriodAnchorBar = 0
if isPeriodAnchor
    lastPeriodAnchorBar := bar_index

// Persistent references for polyline drawing management
var polyline plVwap   = na
var polyline plU1     = na
var polyline plL1     = na
var polyline plU2     = na
var polyline plL2     = na
var polyline plU3     = na
var polyline plL3     = na
var polyline plFill   = na

// —————————————————————————————————————————————————————————————————————————————
// CALCULATION & RENDERING ON LAST BAR
// —————————————————————————————————————————————————————————————————————————————
if barstate.islast
    // 1. Resolve starting bar offset
    int offset = 0
    int currentLookback = math.min(lookbackLength, bar_index)

    if anchorPeriod == "Highest High"
        offset := math.abs(ta.highestbars(high, currentLookback))
    else if anchorPeriod == "Lowest Low"
        offset := math.abs(ta.lowestbars(low, currentLookback))
    else if anchorPeriod == "Highest Volume"
        offset := math.abs(ta.highestbars(volume, currentLookback))
    else
        offset := math.min(bar_index - lastPeriodAnchorBar, bar_index)

    // Clamp offset to available chart bars
    offset := math.max(0, math.min(offset, bar_index))

    // 2. Clear previous drawings
    polyline.delete(plVwap)
    polyline.delete(plU1)
    polyline.delete(plL1)
    polyline.delete(plU2)
    polyline.delete(plL2)
    polyline.delete(plU3)
    polyline.delete(plL3)
    polyline.delete(plFill)

    // 3. Initialize coordinate point arrays
    var pointsVwap = array.new<chart.point>()
    var pointsU1   = array.new<chart.point>()
    var pointsL1   = array.new<chart.point>()
    var pointsU2   = array.new<chart.point>()
    var pointsL2   = array.new<chart.point>()
    var pointsU3   = array.new<chart.point>()
    var pointsL3   = array.new<chart.point>()
    var pointsFill = array.new<chart.point>()

    array.clear(pointsVwap)
    array.clear(pointsU1)
    array.clear(pointsL1)
    array.clear(pointsU2)
    array.clear(pointsL2)
    array.clear(pointsU3)
    array.clear(pointsL3)
    array.clear(pointsFill)

    // 4. Cumulative calculations forward from anchor bar
    float cumPV  = 0.0
    float cumVol = 0.0
    float cumPV2 = 0.0

    for i = offset to 0
        int targetBarIndex = bar_index - i
        float p = src[i]
        float v = nz(volume[i], 1.0) // Fallback for charts without volume

        cumPV  += p * v
        cumVol += v
        cumPV2 += p * p * v

        float curVwap = cumVol > 0 ? cumPV / cumVol : p
        
        // Dispersion math
        float dev = 0.0
        if calcMode == "Standard Deviation"
            float variance = math.max(0.0, (cumPV2 / cumVol) - (curVwap * curVwap))
            dev := math.sqrt(variance)
        else
            // Percentage: 1.0 multiplier = 1% of current VWAP
            dev := curVwap * 0.01

        // Record main VWAP coordinate
        array.push(pointsVwap, chart.point.from_index(targetBarIndex, curVwap))

        // Record Band 1
        if showBand1
            array.push(pointsU1, chart.point.from_index(targetBarIndex, curVwap + mult1 * dev))
            array.push(pointsL1, chart.point.from_index(targetBarIndex, curVwap - mult1 * dev))

        // Record Band 2
        if showBand2
            array.push(pointsU2, chart.point.from_index(targetBarIndex, curVwap + mult2 * dev))
            array.push(pointsL2, chart.point.from_index(targetBarIndex, curVwap - mult2 * dev))

        // Record Band 3
        if showBand3
            array.push(pointsU3, chart.point.from_index(targetBarIndex, curVwap + mult3 * dev))
            array.push(pointsL3, chart.point.from_index(targetBarIndex, curVwap - mult3 * dev))

    // 5. Draw active polylines
    if array.size(pointsVwap) > 0
        plVwap := polyline.new(pointsVwap, line_color=vwapColor, line_width=vwapWidth)

        // Fill inner channel if Band 1 is enabled
        if fillBands and showBand1 and array.size(pointsU1) > 0
            // Construct closed polygon loop: Upper Band forward -> Lower Band backward
            for pt in pointsU1
                array.push(pointsFill, pt)
            for j = array.size(pointsL1) - 1 to 0
                array.push(pointsFill, array.get(pointsL1, j))
            plFill := polyline.new(pointsFill, closed=true, line_color=color.new(color.white, 100), fill_color=fillColor)

        // Draw individual band lines
        if showBand1
            plU1 := polyline.new(pointsU1, line_color=colorBand1, line_width=1)
            plL1 := polyline.new(pointsL1, line_color=colorBand1, line_width=1)
        if showBand2
            plU2 := polyline.new(pointsU2, line_color=colorBand2, line_width=1)
            plL2 := polyline.new(pointsL2, line_color=colorBand2, line_width=1)
        if showBand3
            plU3 := polyline.new(pointsU3, line_color=colorBand3, line_width=1)
            plL3 := polyline.new(pointsL3, line_color=colorBand3, line_width=1)